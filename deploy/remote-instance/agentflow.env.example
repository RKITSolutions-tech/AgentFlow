# Environment for a *remote* AgentFlow instance that a master instance will
# federate with (docs/REMOTE_INSTANCE_SETUP.md). Copy to agentflow.env and
# fill in real values -- agentflow.env is gitignored, this .example is not.
#
# setup.sh writes agentflow.env for you; this file exists so you can see (or
# hand-edit) exactly what it sets.

# This machine's address on your private network (Tailscale IP/hostname or
# LAN hostname) -- NOT "localhost". The master instance connects here.
AGENTFLOW_HOST=

# Required to bind to the address above instead of loopback-only. This is
# what actually exposes AgentFlow (command execution, no built-in auth) --
# only ever do this on a private network. See docs/HIGH_LEVEL_DESIGN.md §20
# and docs/CLOUDCLI_GAP_ANALYSIS.md G11.
AGENTFLOW_ALLOW_UNSAFE_BIND=1

AGENTFLOW_PORT=5000

# Shared secret the master must present (Authorization: Bearer <token>) to
# this instance's federation API (app/federation/routes.py). Generate with
# e.g. `openssl rand -hex 32`. Leaving this unset disables federation --
# every /federation/api/* route 503s.
AGENTFLOW_FEDERATION_TOKEN=

# Repository roots this instance is allowed to open as a Project (docs/
# AGENT_ADAPTER.md, app/security.py). Colon-separated on Linux/WSL,
# semicolon-separated on native Windows. Point this at wherever you clone
# projects on this machine.
AGENTFLOW_ALLOWED_ROOTS=

AGENTFLOW_DATABASE_PATH=instance/agentflow.sqlite3
